{
  "name": "gameuniverse",
  "description": "Agent principal pour le développement de Game Universe",
  "resources": [
    {
      "type": "knowledgeBase",
      "source": "file://./docs",
      "name": "Documentation projet",
      "indexType": "best",
      "include": ["**/*.md"],
      "exclude": ["**/draft/**"],
      "autoUpdate": true
    },
    {
      "type": "knowledgeBase",
      "source": "file://./src",
      "name": "Code source",
      "indexType": "fast",
      "include": ["**/*.ts", "**/*.tsx"],
      "exclude": ["**/*.test.*", "**/*.d.ts"],
      "autoUpdate": true
    }
  ]
}
