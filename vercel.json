{
  "git": {
    "deploymentEnabled": {
      "main": false
    }
  },
  "installCommand": "bunx bun@1.4.2 install",
  "buildCommand": "bunx bun@1.4.2 run build",
  "crons": [
    {
      "path": "/api/cron/sync-libraries",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/purge-deleted-accounts",
      "schedule": "30 4 * * *"
    }
  ]
}
