# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Next.js Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# IGDB API Configuration (Twitch OAuth)
IGDB_CLIENT_ID=your_twitch_client_id
IGDB_CLIENT_SECRET=your_twitch_client_secret
IGDB_WEBHOOK_SECRET=your_igdb_webhook_secret

# Vercel AI Gateway (traduction automatique)
AI_GATEWAY_API_KEY=your_vercel_ai_gateway_api_key

# Google Custom Search (image search for characters)
GOOGLE_CSE_API_KEY=your_google_cse_api_key
GOOGLE_CSE_CX=your_google_cse_cx

# Linked platforms — AES-256-GCM key used to encrypt access/refresh tokens at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PLATFORM_TOKEN_ENCRYPTION_KEY=base64_32_byte_key

# Gaming platform OAuth clients
# Steam — only needs an API key (no OAuth client). Get one at https://steamcommunity.com/dev/apikey
STEAM_API_KEY=your_steam_web_api_key
# Xbox — Microsoft Azure app with XboxLive.signin + XboxLive.offline_access scopes
XBOX_CLIENT_ID=your_xbox_client_id
XBOX_CLIENT_SECRET=your_xbox_client_secret
# Epic Games — dev.epicgames.com "Game Client" app
EPIC_CLIENT_ID=your_epic_client_id
EPIC_CLIENT_SECRET=your_epic_client_secret
# Discord — https://discord.com/developers
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
# Battle.net — https://develop.battle.net
BATTLENET_CLIENT_ID=your_battlenet_client_id
BATTLENET_CLIENT_SECRET=your_battlenet_client_secret
# itch.io — https://itch.io/user/settings/oauth-apps (implicit flow, no secret)
ITCH_CLIENT_ID=your_itch_client_id

# PandaScore — esports data (tournaments, matches, teams, players)
# Get your token at https://app.pandascore.co/dashboard
PANDASCORE_API_KEY=your_pandascore_api_key

# Stripe (coaching payments via Stripe Connect)
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Cron — shared secret required to call /api/cron/* endpoints.
# Vercel Cron Jobs send this automatically as Bearer when configured via vercel.json + env.
CRON_SECRET=your_cron_secret
