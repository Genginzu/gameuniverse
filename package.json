{
  "name": "gameuniverse",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun --bun next dev",
    "build": "bun --bun next build",
    "start": "bun --bun next start",
    "lint": "bun eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "bun eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "bun prettier --write .",
    "format:check": "bun prettier --check .",
    "type-check": "bun tsc --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:run": "bun test --run",
    "test:coverage": "bun test --coverage",
    "clean": "bun rimraf .next dist coverage",
    "check-all": "powershell -ExecutionPolicy Bypass -File scripts/check-all.ps1",
    "check-all:unix": "bash scripts/check-all.sh",
    "supabase:start": "bunx supabase start",
    "supabase:stop": "bunx supabase stop",
    "supabase:status": "bunx supabase status",
    "supabase:reset": "bunx supabase db reset",
    "supabase:migrate": "bunx supabase db push",
    "supabase:seed": "bunx supabase db seed",
    "supabase:types": "bunx supabase gen types typescript --local > src/lib/database.types.ts"
  },
  "dependencies": {
    "@supabase/auth-helpers-nextjs": "0.15.0",
    "@supabase/supabase-js": "2.89.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "next": "^16.1.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-icons": "5.5.0",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.3",
    "@eslint/js": "9.39.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.1",
    "@testing-library/user-event": "14.6.1",
    "@types/bun": "latest",
    "@types/jsdom": "27.0.0",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "8.51.0",
    "@typescript-eslint/parser": "8.51.0",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.4",
    "jsdom": "27.4.0",
    "postcss": "^8.5.6",
    "prettier": "3.7.4",
    "prettier-plugin-tailwindcss": "0.7.2",
    "rimraf": "6.1.2",
    "supabase": "2.70.5",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.9.3"
  }
}
