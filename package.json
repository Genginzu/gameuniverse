{
  "name": "gameuniverse",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "bun --bun next dev -H 0.0.0.0",
    "build": "bun --bun next build",
    "start": "bun --bun next start",
    "lint": "bun eslint .",
    "lint:fix": "bun eslint . --fix",
    "format": "bun prettier --write .",
    "format:check": "bun prettier --check .",
    "type-check": "bun tsc --noEmit",
    "test": "bunx vitest run",
    "test:watch": "bunx vitest",
    "test:coverage": "bunx vitest run --coverage",
    "test:all": "bunx vitest run",
    "clean": "bun rimraf .next dist coverage",
    "check-all": "powershell -ExecutionPolicy Bypass -File scripts/check-all.ps1",
    "check-all:unix": "bash scripts/check-all.sh",
    "supabase:start": "bunx supabase start",
    "supabase:stop": "bunx supabase stop",
    "supabase:status": "bunx supabase status",
    "supabase:reset": "bunx supabase db reset",
    "supabase:migrate": "bunx supabase db push",
    "supabase:seed": "bunx supabase db seed",
    "supabase:types": "bunx supabase gen types typescript --local > src/lib/database.types.ts",
    "test:e2e": "npx --yes playwright test",
    "test:e2e:ui": "npx --yes playwright test --ui",
    "test:e2e:headed": "npx --yes playwright test --headed"
  },
  "dependencies": {
    "@ai-sdk/openai": "3.0.52",
    "@hookform/resolvers": "5.2.2",
    "@iconify/react": "6.0.2",
    "@radix-ui/react-checkbox": "1.3.3",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-toast": "1.2.15",
    "@supabase/ssr": "0.10.2",
    "@supabase/supabase-js": "2.103.0",
    "@tiptap/pm": "3.22.3",
    "@tiptap/react": "3.22.3",
    "@tiptap/starter-kit": "3.22.3",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "ai": "6.0.154",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "country-flag-icons": "1.6.15",
    "embla-carousel-react": "8.6.0",
    "jimp": "1.6.1",
    "next": "16.2.3",
    "next-intl": "4.9.0",
    "next-themes": "0.4.6",
    "postgres": "3.4.9",
    "psn-api": "2.18.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-hook-form": "7.72.1",
    "recharts": "3.8.1",
    "stripe": "17.7.0",
    "swr": "2.4.1",
    "tailwind-merge": "3.5.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.59.1",
    "@tailwindcss/postcss": "4.2.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/bun": "1.3.11",
    "@types/jsdom": "28.0.1",
    "@types/node": "25.5.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "8.58.1",
    "@typescript-eslint/parser": "8.58.1",
    "@vitejs/plugin-react": "6.0.1",
    "eslint": "10.2.0",
    "eslint-config-next": "16.2.3",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.5",
    "fast-check": "4.6.0",
    "jsdom": "29.0.2",
    "postcss": "8.5.9",
    "prettier": "3.8.1",
    "prettier-plugin-tailwindcss": "0.7.2",
    "rimraf": "6.1.3",
    "supabase": "2.88.1",
    "tailwindcss": "4.2.2",
    "typescript": "6.0.2",
    "vite": "8.0.8",
    "vitest": "4.1.4"
  }
}
