{
  "name": "gameuniverse",
  "version": "0.4.2",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "node -e \"try{require('child_process').execSync('git config core.hooksPath .githooks',{stdio:'ignore'})}catch(e){}\" && bun scripts/setup-agents.ts",
    "dev": "bun --bun next dev -H 0.0.0.0",
    "build": "next build",
    "start": "bun --bun next start",
    "lint": "bun eslint .",
    "lint:fix": "bun eslint . --fix",
    "format": "bun prettier --write .",
    "format:check": "bun prettier --check .",
    "type-check": "bun tsc --noEmit",
    "test": "bunx vitest run",
    "test:watch": "bunx vitest",
    "test:coverage": "bunx vitest run --coverage",
    "test:all": "bunx vitest run",
    "clean": "bun rimraf .next dist coverage",
    "check-all": "powershell -ExecutionPolicy Bypass -File scripts/dev/check-all.ps1",
    "check-all:unix": "bash scripts/dev/check-all.sh",
    "check:agent-symlinks": "bun scripts/check-agent-symlinks.ts",
    "check:skill-discovery": "bun scripts/check-skill-discovery.ts",
    "supabase:start": "bunx supabase start",
    "supabase:stop": "bunx supabase stop",
    "supabase:status": "bunx supabase status",
    "supabase:reset": "bunx supabase db reset",
    "supabase:migrate": "bunx supabase db push",
    "supabase:seed": "bunx supabase db seed",
    "supabase:types": "bunx supabase gen types typescript --local > src/lib/database.types.ts",
    "test:e2e": "npx --yes playwright test",
    "test:e2e:ui": "npx --yes playwright test --ui",
    "test:e2e:headed": "npx --yes playwright test --headed"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.70",
    "@hookform/resolvers": "5.9.1",
    "@iconify/react": "6.0.2",
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-toast": "1.3.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "ai": "7.0.106",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "country-flag-icons": "1.6.20",
    "embla-carousel-react": "8.6.0",
    "jimp": "1.6.1",
    "next": "16.4.0",
    "next-intl": "4.14.9",
    "next-themes": "0.4.6",
    "postgres": "3.4.9",
    "psn-api": "2.18.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.88.0",
    "recharts": "3.10.1",
    "resend": "6.29.0",
    "sanitize-html": "2.18.1",
    "stripe": "22.6.2",
    "swr": "2.5.1",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/bun": "1.4.2",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.2",
    "@typescript-eslint/eslint-plugin": "8.71.2",
    "@typescript-eslint/parser": "8.71.2",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "fast-check": "4.10.2",
    "jsdom": "30.1.3",
    "postcss": "8.5.29",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "rimraf": "6.1.3",
    "supabase": "2.120.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vitest": "4.1.12"
  }
}
